{
  "name": "skm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.9",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm --filter @skm/core build && pnpm --filter @skm/api build && pnpm -r test",
    "typecheck": "pnpm --filter @skm/core build && pnpm --filter @skm/api build && pnpm -r typecheck",
    "skm": "node packages/cli/dist/index.js",
    "dev": "pnpm --filter @skm/api dev",
    "dev:api": "pnpm --filter @skm/api dev",
    "dev:web": "pnpm --filter @skm/web dev"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.1.1",
    "@types/node": "^22.14.0"
  }
}
